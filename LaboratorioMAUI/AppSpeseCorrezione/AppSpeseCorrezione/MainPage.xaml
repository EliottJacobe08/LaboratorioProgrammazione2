<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AppSpeseCorrezione.MainPage">

    <ScrollView>
        <VerticalStackLayout
            Padding="30,0"
            Spacing="25">

            <Label Text="LE MIE SPESE"
                   FontSize="20"
                   FontAttributes="Bold"
                   TextColor="Blue"
                   HorizontalOptions="Center"></Label>

            <Entry x:Name="EntNomeLista"
                   Placeholder="inserisci il nome del mese"
                   AutomationId="EntNomeLista"
                   BackgroundColor="White"
                   TextColor="Black"
                   PlaceholderColor="Gray"></Entry>

            <Entry x:Name="EntDescrizione"
                   AutomationId="EntDescrizione"
                   Placeholder="descrizione"
                   BackgroundColor="White"
                   TextColor="Black"
                   PlaceholderColor="Gray"></Entry>
             
                   
            
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
