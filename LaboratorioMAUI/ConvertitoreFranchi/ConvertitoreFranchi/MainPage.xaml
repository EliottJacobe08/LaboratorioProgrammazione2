<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ConvertitoreFranchi.MainPage">

    <ScrollView>
        <VerticalStackLayout
            Padding="30,0"
            Spacing="25">

            <Label
                Text="Convertitore franchi-euro"
                Style="{StaticResource Headline}"
                SemanticProperties.HeadingLevel="Level1" />

            <Entry Keyboard="Numeric" 
                   x:Name="InputFranchi"
                   Placeholder="inserisci montante" />
            
            <Button
                x:Name="ConverterBtn"
                Text="Converti in Euro" 
                Clicked="OnConverterClicked"
                HorizontalOptions="Fill" />

            <Label x:Name="LblRisultato"/>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
